'use client'

import React, { useState } from 'react'
import FileUploader from '@/components/FileUploader'
import VisualPreview from '@/components/VisualPreview'
import PreflightResults from '@/components/PreflightResults'
import PrintPreview from '@/components/PrintPreview'
import BleedAdderTool from '@/components/BleedAdderTool'
import BleedRemovalTool from '@/components/BleedRemovalTool'
import PDFColorChanger from '@/components/PDFColorChanger'
import PullUpBannerTool from '@/components/PullUpBannerTool'
import { validateArtwork } from '@/lib/validation-rules'

interface UploadState {
  file: File | null
  uploading: boolean
  results: any | null
  error: string | null
}

type ActiveTool = 'upload' | 'bleed-add' | 'bleed-remove' | 'color-change' | 'pullup-banner'

export default function Home() {
  const [uploadState, setUploadState] = useState<UploadState>({
    file: null,
    uploading: false,
    results: null,
    error: null
  })
  const [activeTool, setActiveTool] = useState<ActiveTool>('upload')

  const handleFileSelect = async (file: File) => {
    setUploadState({
      file,
      uploading: true,
      results: null,
      error: null
    })

    try {
      const results = await validateArtwork(file)
      setUploadState({
        file,
        uploading: false,
        results,
        error: null
      })
    } catch (error) {
      setUploadState({
        file,
        uploading: false,
        results: null,
        error: error instanceof Error ? error.message : 'An error occurred'
      })
    }
  }

  const renderToolContent = () => {
    switch (activeTool) {
      case 'upload':
        return (
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div>
              <FileUploader onFileSelect={handleFileSelect} />
              {uploadState.error && (
                <div className="mt-4 p-4 bg-red-50 border border-red-200 rounded-md">
                  <p className="text-red-800">{uploadState.error}</p>
                </div>
              )}
            </div>
            <div>
              {uploadState.file && (
                <VisualPreview file={uploadState.file} />
              )}
            </div>
          </div>
        )
      case 'bleed-add':
        return <BleedAdderTool />
      case 'bleed-remove':
        return <BleedRemovalTool />
      case 'color-change':
        return <PDFColorChanger />
      case 'pullup-banner':
        return <PullUpBannerTool />
      default:
        return null
    }
  }

  return (
    <div className="min-h-screen gradient-bg p-6">
      {/* Tool Navigation Buttons with vertical dividers */}
      <div className="flex items-center mb-6">
        <button
          onClick={() => setActiveTool('upload')}
          className={`px-4 py-2 font-medium transition-colors ${
            activeTool === 'upload'
              ? 'bg-blue-600 text-white'
              : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
          }`}
        >
          📁 File Upload & Validation
        </button>
        <div className="w-px h-8 bg-gray-300 mx-2"></div>
        <button
          onClick={() => setActiveTool('bleed-add')}
          className={`px-4 py-2 font-medium transition-colors ${
            activeTool === 'bleed-add'
              ? 'bg-blue-600 text-white'
              : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
          }`}
        >
          ➕ Add Bleed
        </button>
        <div className="w-px h-8 bg-gray-300 mx-2"></div>
        <button
          onClick={() => setActiveTool('bleed-remove')}
          className={`px-4 py-2 font-medium transition-colors ${
            activeTool === 'bleed-remove'
              ? 'bg-blue-600 text-white'
              : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
          }`}
        >
          ➖ Remove Bleed
        </button>
        <div className="w-px h-8 bg-gray-300 mx-2"></div>
        <button
          onClick={() => setActiveTool('color-change')}
          className={`px-4 py-2 font-medium transition-colors ${
            activeTool === 'color-change'
              ? 'bg-blue-600 text-white'
              : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
          }`}
        >
          🎨 Color Conversion
        </button>
        <div className="w-px h-8 bg-gray-300 mx-2"></div>
        <button
          onClick={() => setActiveTool('pullup-banner')}
          className={`px-4 py-2 font-medium transition-colors ${
            activeTool === 'pullup-banner'
              ? 'bg-blue-600 text-white'
              : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
          }`}
        >
          🏷️ Pull-Up Banner Template
        </button>
      </div>

      {/* Main Content Area - Dashed Border */}
      <div className="border-2 border-dashed border-gray-400 bg-gray-50 p-8 rounded-lg min-h-96">
        <div className="flex items-center justify-center h-full">
          {/* Abstract black graphic placeholder */}
          <div className="w-64 h-64 bg-black rounded-full opacity-20"></div>
        </div>
      </div>

      {/* Results Section */}
      {uploadState.results && activeTool === 'upload' && (
        <div className="mt-8">
          <PreflightResults results={uploadState.results} />
        </div>
      )}

      {/* Print Preview */}
      {uploadState.file && activeTool === 'upload' && (
        <div className="mt-8">
          <PrintPreview file={uploadState.file} />
        </div>
      )}
    </div>
  )
}
